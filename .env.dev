# DEV 환경: 개발 서버에서 여러 기능을 통합 검증
# 이 파일은 dev 프로필로 실행할 때 systemd EnvironmentFile로 읽습니다.
# start:dev / stop:dev / status:dev 명령어와 연결됩니다.
# PORT=7002: 이 환경에서 모니터링 서버가 사용하는 HTTP 포트입니다.
# 아래의 Gmail 주소/앱 비밀번호는 예시 값입니다. 실제 값으로 수정해야 메일이 전송됩니다.
# 실제 비밀번호가 포함된 파일은 Git에 커밋하지 마세요.
#
# 설정 항목 설명
# MONITORING_ENABLED: 다른 MSA 서버의 TCP 연결 상태 검사 여부
# MONITORING_INTERVAL_MS: 검사 간격(ms, 600000=10분)
# MONITORING_INITIAL_DELAY_MS: 서버 시작 후 첫 검사 대기(ms)
# MONITORING_CONNECT_TIMEOUT_MS: 대상 TCP 연결 제한 시간(ms)
# MONITOR_OAUTH/LOG/SOCKET_HOST,PORT: 검사할 각 MSA의 주소와 포트
# MONITORING_EMAIL_ENABLED: MSA 장애 이메일 발송 여부
# MAIL_HOST/MAIL_PORT: SMTP 서버 주소와 포트
# MAIL_USERNAME: 발신 Gmail 계정
# MAIL_PASSWORD: Gmail 앱 비밀번호 (일반 로그인 비밀번호 아님)
# MONITOR_EMAIL_TO: 장애/종료 알림을 받을 이메일 주소
# LIFECYCLE_EMAIL_ENABLED: 정상적인 JVM 종료 시 알림 메일 발송 여부
# WATCHDOG_*: 이전 독립 watchdog 관련 설정 (현재 별도 watchdog 서비스는 설치하지 않음)
# 비정상 JVM 종료 시에는 systemd ExecStopPost가 별도로 알림을 시도합니다.

PORT=7002

# Database settings (adjust for this environment). Local defaults to embedded H2.
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/main
# SPRING_DATASOURCE_USERNAME=your_user
# SPRING_DATASOURCE_PASSWORD=your_password
# JWT_SECRET=replace_with_a_unique_secret

# Monitor other MSA services (TCP connection check; set real host/IP and port).
MONITORING_ENABLED=true
MONITORING_INTERVAL_MS=600000
MONITORING_INITIAL_DELAY_MS=1000
MONITORING_CONNECT_TIMEOUT_MS=3000
MONITOR_OAUTH_HOST=127.0.0.1
MONITOR_OAUTH_PORT=7102
MONITOR_LOG_HOST=127.0.0.1
MONITOR_LOG_PORT=7103
MONITOR_SOCKET_HOST=127.0.0.1
MONITOR_SOCKET_PORT=7104

# Gmail alerts for monitored services. Use a Google App Password, not account password.
MONITORING_EMAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MONITOR_EMAIL_TO=

# Independent watchdog monitors THIS monitoring service from a separate process.
WATCHDOG_ENABLED=false
WATCHDOG_HEALTH_URL=http://127.0.0.1:7002/api/v1/health
WATCHDOG_CHECK_INTERVAL_SECONDS=10
WATCHDOG_ALERT_INTERVAL_MINUTES=1
WATCHDOG_MAX_EMAILS=10
WATCHDOG_CONNECT_TIMEOUT_SECONDS=3
WATCHDOG_INITIAL_DELAY_SECONDS=30
WATCHDOG_FAILURE_THRESHOLD=2

# Spring lifecycle shutdown notification (graceful shutdown only).
LIFECYCLE_EMAIL_ENABLED=true
